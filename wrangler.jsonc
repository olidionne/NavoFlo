{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "navoflo",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "NAVOFLO_DB",
      "database_name": "navoflo-prod",
      "database_id": "049d0b7d-cd2c-4dd6-af23-1ccd3634d737"
    }
  ],
  "keep_vars": true
}
